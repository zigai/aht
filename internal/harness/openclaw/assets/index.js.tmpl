// aht managed integration
// This plugin intentionally ignores prompts, messages, responses, and errors.
// Native hook/cleanup contract: https://docs.openclaw.ai/plugins/hooks
import { spawn } from "node:child_process";
import { definePluginEntry } from "openclaw/plugin-sdk/plugin-entry";

const binary = {{BINARY}};
const integrationVersion = {{INTEGRATION_VERSION}};
const pendingReports = [];
const maxPendingReports = 64;
let activeReport = false;
let reportingWarningShown = false;
let reportingStopped = false;
let lastReport = Promise.resolve();

function warnReporting() {
  if (reportingWarningShown) return;
  reportingWarningShown = true;
  console.warn("aht: reporting failed or overloaded; some state updates were dropped.");
}

// Own one referenced child at a time. Keep the newest state under overload,
// retaining FIFO order for the accepted reports and their enqueue-time metadata.
function enqueueReport(args) {
  if (reportingStopped) return Promise.resolve();
  lastReport = new Promise((complete) => {
    if (pendingReports.length >= maxPendingReports) {
      pendingReports.shift().complete();
      warnReporting();
    }
    pendingReports.push({ args, complete });
    drainReports();
  });
  return lastReport;
}

function stopReporting() {
  reportingStopped = true;
  // Bound shutdown to the active child and newest/final queued state.
  while (pendingReports.length > 1) {
    pendingReports.shift().complete();
    warnReporting();
  }
  return lastReport;
}

function drainReports() {
  if (activeReport) return;
  const report = pendingReports.shift();
  if (!report) return;
  activeReport = true;
  let child;
  try {
    child = spawn(binary, report.args, { stdio: "ignore" });
  } catch {
    warnReporting();
    activeReport = false;
    report.complete();
    drainReports();
    return;
  }
  let killTimer;
  const timeout = setTimeout(() => {
    warnReporting();
    child.kill("SIGTERM");
    killTimer = setTimeout(() => child.kill("SIGKILL"), 100);
  }, 1000);
  child.once("error", warnReporting);
  // "close", including after a spawn error, joins the child before the next job.
  child.once("close", (code) => {
    clearTimeout(timeout);
    clearTimeout(killTimer);
    if (code !== 0) warnReporting();
    activeReport = false;
    report.complete();
    drainReports();
  });
}
const sessions = new Map();

function text(value) {
  return typeof value === "string" ? value.trim() : "";
}

function remember(sessionId, values) {
  const current = sessions.get(sessionId) ?? {};
  const next = { ...current };
  for (const [key, value] of Object.entries(values)) {
    if (text(value)) next[key] = text(value);
  }
  sessions.set(sessionId, next);
  return next;
}

function attribute(args, key, value) {
  if (text(value)) args.push("--attribute", `${key}=${text(value)}`);
}

function report(eventName, event, ctx, transition) {
  const sessionId = text(event.sessionId) || text(ctx.sessionId) || text(event.sessionKey) || text(ctx.sessionKey);
  if (!sessionId) return;

  const metadata = remember(sessionId, {
    sessionKey: event.sessionKey || ctx.sessionKey,
    agentId: ctx.agentId,
    workspaceDir: ctx.workspaceDir,
    runId: event.runId || ctx.runId,
    sessionFile: event.sessionFile,
  });
  const args = [
    "report", "openclaw", "--session-id", sessionId,
    "--event", eventName, "--observed-at", new Date().toISOString(),
    "--quiet", "--no-tmux",
    "--attribute", "aht_integration=openclaw-plugin",
    "--attribute", `aht_integration_version=${integrationVersion}`,
  ];
  if (transition.lifecycle) args.push("--lifecycle", transition.lifecycle);
  if (transition.presence) args.push("--presence", transition.presence);
  if (transition.activity) args.push("--activity", transition.activity);
  if (metadata.sessionFile) args.push("--session-path", metadata.sessionFile);
  if (metadata.workspaceDir) args.push("--cwd", metadata.workspaceDir, "--project-root", metadata.workspaceDir);
  if (metadata.sessionKey) {
    for (const item of ["openclaw", "tui", "--session", metadata.sessionKey]) {
      args.push("--resume-command", item);
    }
  }
  attribute(args, "openclaw_session_key", metadata.sessionKey);
  attribute(args, "openclaw_agent_id", metadata.agentId);
  attribute(args, "openclaw_run_id", metadata.runId);
  attribute(args, "openclaw_end_reason", event.reason);
  if (typeof event.success === "boolean") attribute(args, "openclaw_success", String(event.success));

  if (transition.lifecycle === "end") sessions.delete(sessionId);
  return enqueueReport(args);
}

export default definePluginEntry({
  id: "aht-state",
  name: "AHT State",
  description: "Reports OpenClaw lifecycle metadata without conversation content.",
  register(api) {
    api.on("gateway_stop", stopReporting);
    api.on("session_start", (event, ctx) => report("session_start", event, ctx, {
      lifecycle: text(event.resumedFrom) ? "resume" : "start", presence: "live", activity: "idle",
    }));
    api.on("before_agent_run", (_event, ctx) => report("before_agent_run", {}, ctx, { presence: "live", activity: "running" }));
    api.on("agent_end", (event, ctx) => {
      let activity = "idle";
      // OpenClaw's embedded runner emits success=false without error on abort;
      // prompt failures carry error. PluginHookAgentEndEvent has no reason or
      // aborted field (2026.9.3 builtin-openclaw agent-end side effects).
      if (typeof event?.error === "string") {
        activity = "failed";
      } else if (event?.success === false) {
        activity = "interrupted";
      }
      return report("agent_end", event, ctx, { presence: "live", activity });
    });
    api.on("session_end", (event, ctx) => report("session_end", event, ctx, { lifecycle: "end", presence: "gone" }));
  },
});
