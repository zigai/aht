// aht managed integration
// Native Cline AgentPlugin. This plugin never reads prompt, message, tool input,
// tool output, response, or error content.
// Native lifecycle contract: https://docs.cline.bot/sdk/plugins
import { spawn } from "node:child_process";

const binary = {{BINARY}};
const integrationVersion = {{INTEGRATION_VERSION}};
const pendingReports = [];
const maxPendingReports = 64;
let activeReport = false;
let reportingWarningShown = false;

function warnReporting() {
  if (reportingWarningShown) return;
  reportingWarningShown = true;
  console.warn("aht: reporting failed or overloaded; some state updates were dropped.");
}

// Own one referenced child at a time. Keep the newest state under overload,
// retaining FIFO order for the accepted reports and their enqueue-time metadata.
function enqueueReport(args) {
  return new Promise((complete) => {
    if (pendingReports.length >= maxPendingReports) {
      pendingReports.shift().complete();
      warnReporting();
    }
    pendingReports.push({ args, complete });
    drainReports();
  });
}

function drainReports() {
  if (activeReport) return;
  const report = pendingReports.shift();
  if (!report) return;
  activeReport = true;
  let child;
  try {
    child = spawn(binary, report.args, { stdio: "ignore" });
  } catch {
    warnReporting();
    activeReport = false;
    report.complete();
    drainReports();
    return;
  }
  let killTimer;
  const timeout = setTimeout(() => {
    warnReporting();
    child.kill("SIGTERM");
    killTimer = setTimeout(() => child.kill("SIGKILL"), 100);
  }, 1000);
  child.once("error", warnReporting);
  // "close", including after a spawn error, joins the child before the next job.
  child.once("close", (code) => {
    clearTimeout(timeout);
    clearTimeout(killTimer);
    if (code !== 0) warnReporting();
    activeReport = false;
    report.complete();
    drainReports();
  });
}
let sessionId = "";
let workspaceRoot = "";

function text(value) {
  return typeof value === "string" ? value.trim() : "";
}

function attribute(args, key, value) {
  const normalized = text(value);
  if (normalized) args.push("--attribute", `${key}=${normalized}`);
}

function report(eventName, context, transition) {
  const snapshot = context?.snapshot ?? {};
  const identity = sessionId || text(snapshot.conversationId) || text(snapshot.agentId);
  if (!identity) return;

  const args = [
    "report", "cline", "--session-id", identity,
    "--pid", String(process.pid),
    "--event", eventName,
    "--observed-at", new Date().toISOString(),
    "--quiet",
    "--attribute", "aht_integration=cline-plugin",
    "--attribute", `aht_integration_version=${integrationVersion}`,
  ];
  if (transition.presence) args.push("--presence", transition.presence);
  if (transition.activity) args.push("--activity", transition.activity);
  if (workspaceRoot) {
    args.push("--cwd", workspaceRoot, "--project-root", workspaceRoot);
  }
  attribute(args, "cline_agent_id", snapshot.agentId);
  attribute(args, "cline_parent_agent_id", snapshot.parentAgentId);
  attribute(args, "cline_conversation_id", snapshot.conversationId);
  attribute(args, "cline_run_id", snapshot.runId);
  attribute(args, "cline_run_status", context?.resultStatus || snapshot.status);

  return enqueueReport(args);
}

const plugin = {
  name: "aht-state",
  manifest: { capabilities: ["hooks"] },
  setup(_api, ctx) {
    sessionId = text(ctx?.session?.sessionId);
    workspaceRoot = text(ctx?.workspaceInfo?.rootPath);
    return report("setup", {}, { presence: "live", activity: "idle" });
  },
  hooks: {
    beforeRun(context) {
      return report("beforeRun", context, { presence: "live", activity: "running" });
    },
    beforeTool(context) {
      return report("beforeTool", context, { presence: "live", activity: "running" });
    },
    afterTool(context) {
      return report("afterTool", context, { presence: "live", activity: "running" });
    },
    afterRun({ snapshot, result }) {
      const status = text(result?.status || snapshot?.status).toLowerCase();
      let activity = "idle";
      if (status === "error" || status === "failed") {
        activity = "failed";
      } else if (status === "aborted" || status === "interrupted" || status === "cancelled" || status === "canceled") {
        activity = "interrupted";
      }
      return report("afterRun", { snapshot, resultStatus: result?.status }, { presence: "live", activity });
    },
  },
};

export { plugin };
export default plugin;
