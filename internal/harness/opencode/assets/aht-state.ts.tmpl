"{{MANAGED_MARKER}}";
"AHT_INTEGRATION_ID={{INTEGRATION_ID}}";
"AHT_INTEGRATION_VERSION={{INTEGRATION_VERSION}}";
"aht_integration_version={{INTEGRATION_VERSION}}";

import { spawn } from "node:child_process";

const ahtBin = {{BINARY}};
const source = {{SOURCE}};
// Match the OMP producer's cross-process sequence seed so callback ordering
// survives millisecond timestamp ties, including the final idle notifications.
let reportSequence = Date.now() * 1000;

{{TYPESCRIPT_QUEUE}}



{{TYPESCRIPT_EVENT_PARSER}}
// Consumer-only native plugin contract; event bus payloads are parsed as unknown.
// V2: https://opencode.ai/v2/docs/build/plugins/
// V1 (1.18.29+): server() is the bounded V1 compatibility entrypoint.
// Dual entrypoint: V2 loaders invoke setup(), while V1 loaders invoke server().
// Exporting both from a single hermetic object allows one generated file to support
// both runtimes without external dependencies or install-time version branching.
type SessionRefs = {
  readonly directory?: string | undefined;
  readonly projectRoot?: string | undefined;
};

type V1PluginContext = {
  readonly directory?: string | undefined;
  readonly worktree?: string | undefined;
  readonly project?: { readonly path?: string | undefined; readonly root?: string };
  readonly client?: OpenCodeClient;
};
type OpenCodeClient = {
  readonly session?: {
    get(input: { readonly path: { readonly id: string } }): Promise<unknown>;
  };
};
type V1PluginHooks = {
  event(input: { readonly event: unknown }): Promise<void>;
  dispose(): Promise<void>;
};

type V2PluginContext = {
  readonly location?: {
    readonly directory?: string | undefined;
    readonly project?: {
      readonly canonical?: string | undefined;
      readonly directory?: string | undefined;
    } | undefined;
  } | undefined;
  readonly client?: OpenCodeClient;
  readonly event?: {
    subscribe(options?: { readonly signal?: AbortSignal }): AsyncIterable<unknown>;
  } | undefined;
};

function addAttribute(args: string[], key: string, value: unknown): void {
  if (typeof value === "string" && value.length > 0) {
    args.push("--attribute", `${key}=${value}`);
  }
}

function addEvent(args: string[], value: unknown): void {
  if (typeof value === "string" && value.length > 0) {
    args.push("--event", value);
  }
}

function createCore(initialRefs?: SessionRefs, client?: OpenCodeClient) {
  let currentSessionId: string | undefined;
  let currentSessionPath: string | undefined;
  let currentCwd: string | undefined = initialRefs?.directory;
  let currentProjectRoot: string | undefined = initialRefs?.projectRoot;

  function setRefs(refs: SessionRefs): void {
    if (refs.directory) currentCwd = refs.directory;
    if (refs.projectRoot) currentProjectRoot = refs.projectRoot;
  }

  function refreshSessionRef(event: unknown): void {
    currentSessionId = firstPathString(event, [
      ["sessionID"],
      ["sessionId"],
      ["session_id"],
      ["data", "sessionID"],
      ["data", "sessionId"],
      ["data", "session_id"],
      ["properties", "sessionID"],
      ["properties", "sessionId"],
      ["properties", "session_id"],
      ["properties", "info", "id"],
      ["properties", "info", "sessionID"],
      ["session", "id"],
      ["session", "sessionID"],
      ["session", "sessionId"],
    ]) ?? currentSessionId;

    currentSessionPath = firstPathString(event, [
      ["sessionPath"],
      ["session_path"],
      ["path"],
      ["data", "sessionPath"],
      ["data", "session_path"],
      ["data", "path"],
      ["properties", "info", "path"],
      ["properties", "info", "file"],
      ["session", "path"],
      ["session", "file"],
    ]) ?? currentSessionPath;

    currentCwd = firstString(
      currentCwd,
      valueAt(event, ["cwd"]),
      valueAt(event, ["data", "cwd"]),
      valueAt(event, ["session", "cwd"]),
      valueAt(event, ["properties", "cwd"]),
      valueAt(event, ["properties", "info", "directory"]),
    ) ?? currentCwd;

    currentProjectRoot = firstString(
      currentProjectRoot,
      valueAt(event, ["data", "projectRoot"]),
      valueAt(event, ["properties", "info", "directory"]),
    ) ?? currentProjectRoot;
  }

  async function report(state: string, event: unknown): Promise<void> {
    const observedAt = new Date().toISOString();
    refreshSessionRef(event);

    const args = ["report", "opencode", state === "gone" ? "--presence" : "--activity", state, "--observed-at", observedAt, "--sequence", String(++reportSequence), "--quiet"];
    addEvent(args, valueAt(event, ["type"]));
    args.push("--attribute", `aht_integration_version={{INTEGRATION_VERSION}}`);
    if (currentSessionId) {
      args.push("--session-id", currentSessionId);
    }
    if (currentSessionPath) {
      args.push("--session-path", currentSessionPath);
    }
    if (currentCwd) {
      args.push("--cwd", currentCwd);
    }
    if (currentProjectRoot) {
      args.push("--project-root", currentProjectRoot);
    }

    addAttribute(args, "opencode_status", firstPathString(event, [
      ["status", "type"],
      ["data", "status", "type"],
      ["properties", "status", "type"],
      ["session", "status", "type"],
      ["status"],
      ["data", "status"],
      ["properties", "status"],
      ["session", "status"],
    ]));
    if (currentSessionId && client?.session?.get) {
      try {
        const session = await client.session.get({ path: { id: currentSessionId } });
        addAttribute(args, "opencode_title", firstPathString(session, [["title"], ["data", "title"]]));
      } catch {}
    }
    addAttribute(args, "aht_integration", source);

    return enqueueCommand(args);
  }

  async function handle(event: unknown): Promise<void> {
    const state = stateForEvent(event);
    if (state === undefined) {
      return;
    }

    await report(state, event);
  }

  async function drain(): Promise<void> {
    await commandDrain;
  }

  return {
    setRefs,
    handle,
    drain,
  };
}

async function server(ctx: V1PluginContext): Promise<V1PluginHooks> {
  const directory = firstString(ctx?.directory, ctx?.worktree);
  const projectRoot = firstString(ctx?.worktree, ctx?.project?.path, ctx?.project?.root);
  const core = createCore({ directory, projectRoot }, ctx?.client);

  return {
    dispose: async () => {
      await core.drain();
    },
    event: async ({ event }) => {
      await core.handle(event);
    },
  };
}

async function setup(ctx: V2PluginContext): Promise<() => Promise<void>> {
  const directory = ctx?.location?.directory;
  const projectRoot = ctx?.location?.project?.canonical ?? ctx?.location?.project?.directory ?? directory;
  const core = createCore({ directory, projectRoot }, ctx?.client);

  const controller = new AbortController();
  if (ctx?.event?.subscribe) {
    const stream = ctx.event.subscribe({ signal: controller.signal });
    void (async () => {
      try {
        for await (const event of stream) {
          await core.handle(event);
        }
      } catch {
        // Unloaded or aborted subscription
      }
    })();
  }

  return async () => {
    controller.abort();
    await core.drain();
  };
}

export default { id: "aht-state", setup, server };
