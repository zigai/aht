"{{MANAGED_MARKER}}";
"AHT_INTEGRATION_ID={{INTEGRATION_ID}}";
"AHT_INTEGRATION_VERSION={{INTEGRATION_VERSION}}";
"aht_integration_version={{INTEGRATION_VERSION}}";

import { spawn } from "node:child_process";

const ahtBin = {{BINARY}};
const currentSessionSource = {{SOURCE}};
const idleDebounceMs = 150;
const retryGraceMs = 2500;
const heartbeatIntervalMs = 10000;

// Native consumer seam: https://github.com/can1357/oh-my-pi/blob/main/packages/coding-agent/src/extensibility/extensions/types.ts
type ExtensionContext = {
  readonly cwd?: string | undefined;
  readonly isIdle?: () => boolean;
  readonly sessionManager?: {
    readonly getSessionFile?: () => string | undefined;
    readonly getSessionId?: () => string | undefined;
    readonly getCwd?: () => string | undefined;
    readonly getBranch?: () => readonly { readonly type: string }[];
  };
};
type NativeEvent = {
  readonly type?: string | undefined;
  readonly reason?: string | undefined;
  readonly status?: string | undefined;
  readonly kind?: string | undefined;
  readonly toolName?: string | undefined;
  readonly approvalMode?: string | undefined;
  readonly approved?: boolean | undefined;
  readonly interrupted?: boolean | undefined;
  readonly willContinue?: boolean | undefined;
  readonly error?: string | { readonly message?: string | undefined } | undefined;
  readonly message?: string | undefined;
  readonly messages?: readonly unknown[] | undefined;
  readonly args?: unknown;
};
type ExtensionAPI = {
  on(name: string, handler: (event: unknown, ctx: ExtensionContext) => void | Promise<void>): void;
};

// Native event payloads enter only here; fields not consumed by reporting never
// escape this projection (in particular prompts, tool input, and transcripts).
function parseEvent(value: unknown): NativeEvent {
  if (typeof value !== "object" || value === null) return {};
  const fields: Record<string, unknown> = Object.fromEntries(Object.entries(value));
  const stringField = (key: string): string | undefined =>
    typeof fields[key] === "string" ? fields[key] : undefined;
  const error: unknown = fields.error;
  return {
    type: stringField("type"), reason: stringField("reason"),
    status: stringField("status"), kind: stringField("kind"),
    toolName: stringField("toolName"), approvalMode: stringField("approvalMode"),
    approved: typeof fields.approved === "boolean" ? fields.approved : undefined,
    interrupted: fields.interrupted === true, willContinue: fields.willContinue === true,
    error: typeof error === "string" ? error :
      typeof error === "object" && error !== null && "message" in error && typeof error.message === "string"
        ? { message: error.message } : undefined,
    message: stringField("message"),
    messages: Array.isArray(fields.messages) ? fields.messages : undefined,
    args: fields.args,
  };
}

type AssistantResult = { readonly stopReason?: string | undefined; readonly errorMessage?: string | undefined };
function lastAssistantMessage(messages: readonly unknown[] | undefined): AssistantResult | undefined {
  if (!messages) return undefined;
  for (let index = messages.length - 1; index >= 0; index -= 1) {
    const message = messages[index];
    if (typeof message !== "object" || message === null || !("role" in message) || message.role !== "assistant") continue;
    return {
      stopReason: "stopReason" in message && typeof message.stopReason === "string" ? message.stopReason : undefined,
      errorMessage: "errorMessage" in message && typeof message.errorMessage === "string" ? message.errorMessage : undefined,
    };
  }
  return undefined;
}

const retryableErrorPattern =
  /overloaded|provider.?returned.?error|rate.?limit|too many requests|429|500|502|503|504|service.?unavailable|server.?error|internal.?error|network.?error|connection.?error|connection.?refused|connection.?lost|websocket.?closed|websocket.?error|other side closed|fetch failed|upstream.?connect|reset before headers|socket hang up|ended without|http2 request did not get a response|timed? out|timeout|terminated|retry delay/i;

type Activity = "running" | "waiting" | "idle" | "failed" | "interrupted";
type SessionRef = {
  id?: string | undefined;
  path?: string | undefined;
  cwd?: string | undefined;
};
type PendingState = {
  activity: Activity;
  message?: string | undefined;
  ctx?: ExtensionContext | undefined;
  event?: NativeEvent | undefined;
  sequence: number;
};

let reportSequence = Date.now() * 1000;


function nextSequence(): number {
  reportSequence += 1;
  return reportSequence;
}

function isSubagentSession(ctx: ExtensionContext | undefined): boolean {
  try {
    return ctx?.sessionManager?.getBranch?.()?.some((entry) => entry?.type === "session_init") === true;
  } catch {
    return false;
  }
}

function sessionRef(ctx: ExtensionContext | undefined): SessionRef {
  const sessionManager = ctx?.sessionManager;
  const ref: SessionRef = {};
  try {
    const file = sessionManager?.getSessionFile?.();
    if (typeof file === "string" && file.length > 0) ref.path = file;
  } catch {}
  try {
    const id = sessionManager?.getSessionId?.();
    if (typeof id === "string" && id.length > 0) ref.id = id;
  } catch {}
  try {
    const cwd = typeof ctx?.cwd === "string" && ctx.cwd.length > 0 ? ctx.cwd : sessionManager?.getCwd?.();
    if (typeof cwd === "string" && cwd.length > 0) ref.cwd = cwd;
  } catch {}
  return ref;
}

function addAttribute(args: string[], key: string, value: unknown): void {
  if (typeof value === "string" && value.length > 0) {
    args.push("--attribute", `${key}=${value}`);
  }
}

function addResumeCommand(args: string[], ref: SessionRef): void {
  const session = ref.path ?? ref.id;
  if (!session) return;
  for (const item of ["omp", "--session", session]) {
    args.push("--resume-command", item);
  }
}


{{TYPESCRIPT_QUEUE}}

function report(
  activity: Activity | undefined,
  presence: string | undefined,
  ctx?: ExtensionContext,
  event?: NativeEvent,
  lifecycle?: string,
  sequence = nextSequence(),
  message?: string,
): Promise<void> {
  if (isSubagentSession(ctx)) return Promise.resolve();
  const ref = sessionRef(ctx);
  const args = [
    "report",
    "omp",
    "--observed-at",
    new Date().toISOString(),
    "--sequence",
    String(sequence),
    "--quiet",
  ];
  if (presence) args.push("--presence", presence);
  if (activity) args.push("--activity", activity);
  if (lifecycle) args.push("--lifecycle", lifecycle);
  if (typeof event?.type === "string" && event.type.length > 0) {
    args.push("--event", event.type);
  }
  args.push("--attribute", `aht_integration_version={{INTEGRATION_VERSION}}`);
  args.push("--attribute", `aht_integration=${currentSessionSource}`);
  addAttribute(args, "omp_event", event?.type);
  addAttribute(args, "omp_reason", event?.reason);
  addAttribute(args, "omp_tool_name", event?.toolName);
  addAttribute(args, "omp_approval_mode", event?.approvalMode);
  addAttribute(args, "omp_approval_reason", event?.reason);
  addAttribute(args, "agent_state_message", message);
  if (typeof event?.approved === "boolean") {
    addAttribute(args, "omp_approved", String(event.approved));
  }
  if (ref.id) {
    args.push("--session-id", ref.id);
  }
  if (ref.path) {
    args.push("--session-path", ref.path);
  }
  if (ref.cwd) args.push("--cwd", ref.cwd);
  addResumeCommand(args, ref);
  return enqueueCommand(args);
}

function retryableErrorMessage(event: NativeEvent): string | undefined {
  const assistant = lastAssistantMessage(Array.isArray(event?.messages) ? event.messages : []);
  const message = String(
    assistant?.errorMessage ?? (typeof event?.error === "object" ? event.error.message : event?.error) ?? event?.error ?? event?.message ?? "",
  );
  const failed =
    assistant?.stopReason === "error" ||
    event?.reason === "error" ||
    event?.status === "error" ||
    event?.status === "failed" ||
    event?.error;
  return failed && retryableErrorPattern.test(message) ? message || "retryable provider error" : undefined;
}

function askMessage(args: unknown): string {
  if (typeof args !== "object" || args === null || !("questions" in args) || !Array.isArray(args.questions)) return "waiting for user input";
  for (const value of args.questions) {
    if (typeof value === "object" && value !== null && "question" in value && typeof value.question === "string") return value.question;
  }
  return "waiting for user input";
}

export default function (pi: ExtensionAPI) {
  const on = (name: string, handler: (event: NativeEvent, ctx: ExtensionContext) => void | Promise<void>): void => {
    pi.on(name, (event, ctx) => handler(parseEvent(event), ctx));
  };
  let rootSession = false;
  let agentActive = false;
  let retryHoldActive = false;
  let failureActive = false;
  let failureMessage: string | undefined;
  let blockedCount = 0;
  let blockedMessage: string | undefined;
  let lastActivity: Activity | undefined;
  let lastMessage: string | undefined;
  let currentContext: ExtensionContext | undefined;
  let idleTimer: ReturnType<typeof setTimeout> | undefined;
  let retryTimer: ReturnType<typeof setTimeout> | undefined;
  let stateSendInFlight = false;
  let stateDrain: Promise<void> | undefined;
  let pendingState: PendingState | undefined;
  let heartbeatTimer: ReturnType<typeof setInterval> | undefined;

  function clearTimer(timer: ReturnType<typeof setTimeout> | undefined): void {
    if (timer) clearTimeout(timer);
  }

  function clearTimers(): void {
    clearTimer(idleTimer);
    clearTimer(retryTimer);
    stopHeartbeat();
    idleTimer = undefined;
    retryTimer = undefined;
  }

  function startHeartbeat(): void {
    stopHeartbeat();
    heartbeatTimer = setInterval(() => {
      if (!rootSession || !agentActive) {
        stopHeartbeat();
        return;
      }
      publishDesired(undefined, true);
    }, heartbeatIntervalMs);
    heartbeatTimer.unref?.();
  }

  function stopHeartbeat(): void {
    if (heartbeatTimer) {
      clearInterval(heartbeatTimer);
      heartbeatTimer = undefined;
    }
  }

  function desiredState(): { activity: Activity; message?: string | undefined } {
    if (blockedCount > 0) return { activity: "waiting", message: blockedMessage };
    if (failureActive) return { activity: "failed", message: failureMessage };
    if (agentActive || retryHoldActive) return { activity: "running" };
    return { activity: "idle" };
  }

  function queueState(activity: Activity, message?: string, event?: NativeEvent, force = false): void {
    if (!force && activity === lastActivity && message === lastMessage) return;
    lastActivity = activity;
    lastMessage = message;
    const ref = sessionRef(currentContext);
    pendingState = {
      activity,
      message,
      ctx: {
        cwd: ref.cwd,
        sessionManager: {
          getSessionId: () => ref.id,
          getSessionFile: () => ref.path,
        },
      },
      event,
      sequence: nextSequence(),
    };
    if (!stateSendInFlight) stateDrain = drainStateQueue().catch(warnReporting);
  }

  async function drainStateQueue(): Promise<void> {
    if (stateSendInFlight) return;
    stateSendInFlight = true;
    try {
      while (pendingState) {
        const next = pendingState;
        pendingState = undefined;
        await report(next.activity, undefined, next.ctx, next.event, undefined, next.sequence, next.message);
      }
    } finally {
      stateSendInFlight = false;

    }
  }

  function publishDesired(event?: NativeEvent, force = false): void {
    const desired = desiredState();
    queueState(desired.activity, desired.message, event, force);
  }

  function activateRoot(ctx: ExtensionContext): boolean {
    if (isSubagentSession(ctx)) return false;
    rootSession = true;
    currentContext = ctx;
    return true;
  }

  function resetState(): void {
    clearTimers();
    agentActive = false;
    retryHoldActive = false;
    failureActive = false;
    failureMessage = undefined;
    blockedCount = 0;
    blockedMessage = undefined;
  }

  function activateBlocked(message?: string, event?: NativeEvent): void {
    clearTimers();
    blockedCount += 1;
    blockedMessage = message;
    publishDesired(event);
  }

  function deactivateBlocked(event?: NativeEvent): void {
    blockedCount = Math.max(0, blockedCount - 1);
    if (blockedCount === 0) blockedMessage = undefined;
    publishDesired(event);
  }

  function holdRetry(message: string, event?: NativeEvent): void {
    clearTimers();
    retryHoldActive = true;
    failureActive = false;
    failureMessage = message;
    publishDesired(event);
    retryTimer = setTimeout(() => {
      retryTimer = undefined;
      retryHoldActive = false;
      failureActive = true;
      publishDesired(event);
    }, retryGraceMs);
    retryTimer.unref?.();
  }

  function scheduleIdle(event?: NativeEvent): void {
    clearTimers();
    retryHoldActive = false;
    failureActive = false;
    failureMessage = undefined;
    idleTimer = setTimeout(() => {
      idleTimer = undefined;
      publishDesired(event);
    }, idleDebounceMs);
    idleTimer.unref?.();
  }

  on("session_start", (event: NativeEvent, ctx: ExtensionContext) => {
    if (!activateRoot(ctx)) return;
    resetState();
    report("idle", "live", ctx, event, "start");
    lastActivity = "idle";
  });

  for (const eventName of ["session_switch", "session_branch", "session_tree"]) {
    on(eventName, (event: NativeEvent, ctx: ExtensionContext) => {
      if (!activateRoot(ctx)) return;
      resetState();
      report("idle", "live", ctx, event, "resume");
      lastActivity = "idle";
    });
  }

  for (const eventName of ["before_agent_start", "agent_start"]) {
    on(eventName, (event: NativeEvent, ctx: ExtensionContext) => {
      if (!rootSession && !activateRoot(ctx)) return;
      currentContext = ctx;
      clearTimers();
      retryHoldActive = false;
      failureActive = false;
      failureMessage = undefined;
      agentActive = true;
      publishDesired(event);
      startHeartbeat();
    });
  }

  on("tool_approval_requested", (event: NativeEvent, ctx: ExtensionContext) => {
    if (!rootSession && !activateRoot(ctx)) return;
    currentContext = ctx;
    activateBlocked(event?.reason ?? `${event?.toolName ?? "Tool"} approval`, event);
  });

  on("tool_approval_resolved", (event: NativeEvent, ctx: ExtensionContext) => {
    if (!rootSession && !activateRoot(ctx)) return;
    currentContext = ctx;
    deactivateBlocked(event);
  });

  on("tool_execution_start", (event: NativeEvent, ctx: ExtensionContext) => {
    if (event?.toolName !== "ask") return;
    if (!rootSession && !activateRoot(ctx)) return;
    currentContext = ctx;
    activateBlocked(askMessage(event?.args), event);
  });

  on("tool_execution_end", (event: NativeEvent, ctx: ExtensionContext) => {
    if (event?.toolName !== "ask") return;
    if (!rootSession && !activateRoot(ctx)) return;
    currentContext = ctx;
    deactivateBlocked(event);
  });

  on("agent_end", (event: NativeEvent, ctx: ExtensionContext) => {
    if (!rootSession || !agentActive || event?.willContinue === true) return;
    currentContext = ctx ?? currentContext;
    agentActive = false;
    stopHeartbeat();
    const retryable = retryableErrorMessage(event);
    if (retryable) {
      holdRetry(retryable, event);
      return;
    }
    const assistant = lastAssistantMessage(Array.isArray(event?.messages) ? event.messages : []);
    if (
      event?.reason === "interrupted" ||
      event?.reason === "cancelled" ||
      event?.interrupted === true ||
      assistant?.stopReason === "aborted" ||
      assistant?.stopReason === "cancelled"
    ) {
      queueState("interrupted", event?.reason ?? assistant?.errorMessage ?? "interrupted", event);
      return;
    }
    if (
      event?.error ||
      event?.reason === "error" ||
      event?.status === "error" ||
      event?.status === "failed" ||
      assistant?.stopReason === "error"
    ) {
      failureActive = true;
      failureMessage = String(assistant?.errorMessage ?? (typeof event?.error === "object" ? event.error.message : event?.error) ?? event?.error ?? event?.reason ?? "agent failed");
      publishDesired(event);
      return;
    }
    scheduleIdle(event);
  });

  on("agent_error", (event: NativeEvent, ctx: ExtensionContext) => {
    if (!rootSession && !activateRoot(ctx)) return;
    currentContext = ctx;
    agentActive = false;
    stopHeartbeat();
    const retryable = retryableErrorMessage(event);
    if (retryable) {
      holdRetry(retryable, event);
      return;
    }
    failureActive = true;
    failureMessage = String((typeof event?.error === "object" ? event.error.message : event?.error) ?? event?.error ?? event?.message ?? "agent failed");
    publishDesired(event);
  });

  on("session_stop", (event: NativeEvent, ctx: ExtensionContext) => {
    if (!rootSession) return;
    currentContext = ctx ?? currentContext;
    resetState();
    publishDesired(event, true);
  });

  on("session_shutdown", async (event: NativeEvent, ctx: ExtensionContext) => {
    if (!rootSession) return;
    clearTimers();
    currentContext = ctx ?? currentContext;
    rootSession = false;
    await stateDrain;
    await report(undefined, "gone", currentContext, event, "end");
  });
}
